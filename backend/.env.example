# Copiar este archivo como ".env" (o exportar estas variables en tu entorno)
# y completar con valores reales. NUNCA subir el ".env" real a git.

DB_URL=jdbc:postgresql://localhost:5432/talentomdd
DB_USERNAME=postgres
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRATION_MS=86400000

FRONTEND_ORIGIN=http://localhost:5173

# create | update | validate | none
# NUNCA usar "create" en un entorno compartido/producción.
DDL_AUTO=update
